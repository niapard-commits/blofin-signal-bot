# Copy this file to ".env" and fill it in. NEVER commit ".env".

# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# Exact title of the signal channel your account reads
TG_CHANNEL=
# Bot token from @BotFather (open the bot once and press Start)
BOT_TOKEN=

# --- Exchange ---
# mock   = in-memory simulator (play money, no keys needed)
# blofin = BloFin
EXCHANGE=blofin
# demo (default) or prod. prod = REAL money and also needs BLOFIN_ALLOW_REAL=yes
BLOFIN_ENV=demo
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
# letters and digits only; Trade permission, no Transfer/Withdraw
BLOFIN_PASSPHRASE=
# BLOFIN_ALLOW_REAL=yes

# --- Trading settings (optional; all can be changed live with /alloc and /lev) ---
# % of the account used as margin for ONE trade
ALLOCATION_PCT=25
# leverage used when the signal does not state one
DEFAULT_LEVERAGE=10
# hard cap: overrides a higher leverage in a signal
MAX_LEVERAGE=20

# --- Advanced ---
# no = do not keep connections to the exchange open (slower, simpler)
# BLOFIN_KEEPALIVE=no
